{
  "name": "大肥鱼模块 0 · V1 契约测试样本",
  "schemaVersion": "1.0",
  "note": "来源是对《模块0 V1 技术详细设计》§12.1 最小测试集按 V1 收窄范围（只做语言事件）改写。每条 case 的 modelOutput 模拟模型返回，用于校验「Schema + 登记表 + 原文锚定 + 事实地位」这一整层。",
  "cases": [
    {
      "id": "small-talk",
      "note": "寒暄不强制产出事件；events=[] 是正常结果",
      "turn": {
        "sessionId": "session-fix",
        "turn": 1,
        "observedAt": "2026-10-27T09:20:00.000Z",
        "records": [
          { "recordId": "session-fix:5", "seq": 5, "sourceKind": "user_message", "text": "哈哈哈" }
        ]
      },
      "modelOutput": { "schemaVersion": "1.0", "events": [], "noEventReason": "small_talk" },
      "expect": { "events": [] }
    },
    {
      "id": "like-minecraft",
      "note": "偏好表达 → reported，不是兴趣值",
      "turn": {
        "sessionId": "session-fix",
        "turn": 3,
        "observedAt": "2026-10-27T09:21:00.000Z",
        "records": [
          { "recordId": "session-fix:11", "seq": 11, "sourceKind": "user_message", "text": "我最近很喜欢 Minecraft" }
        ]
      },
      "modelOutput": {
        "schemaVersion": "1.0",
        "events": [
          {
            "category": "preference",
            "type": "like_expressed",
            "action": "express_like",
            "target": "Minecraft",
            "targetKind": "object",
            "polarity": "positive",
            "modality": "asserted",
            "sourceRecordId": "session-fix:11",
            "sourceQuote": "我最近很喜欢 Minecraft",
            "timeExpression": "最近"
          }
        ],
        "noEventReason": null
      },
      "expect": {
        "events": [
          {
            "type": "preference.like_expressed",
            "evidenceStatus": "reported",
            "polarity": "positive",
            "actorRef": "owner",
            "target": "Minecraft",
            "quote": "我最近很喜欢 Minecraft"
          }
        ]
      }
    },
    {
