{
  "name": "@local/chonkyfish-dashboard",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "ChonkyFish（大肥鱼）· 小鱼塘管理台：安装本插件会同时注册「大肥鱼」agent preset（含通用工具），对话接入 DSH 会话，并把整个 Harness 换成小鱼塘配色。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/N5Tar/dsh-chonky-fish.git"
  },
  "homepage": "https://github.com/N5Tar/dsh-chonky-fish"
}
